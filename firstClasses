#include <string>
#include <iostream>
#include <vector>
using namespace std;

class User {
protected:
    int id;
    string name;

public:
    User(int id, const string& name) {
        this->id = id;
        this->name = name;
    }

    virtual ~User() = default;

    int getId() const { return id; }
    string getName() const { return name; }
    void setName(const string& name) { this->name = name; }

    virtual void printInfo() const = 0;
};

class Student : public User {
private:
    string group;

public:
    Student(int id, const string& name, const string& group)
        : User(id, name), group(group) {}

    string getGroup() const { return group; }
    void setGroup(const string& group) { this->group = group; }

    void printInfo() const override {
        cout << "[Студент] ID: " << id
             << " | Имя: " << name
             << " | Группа: " << group << endl;
    }
};

class Teacher : public User {
private:
    string subject;

public:
    Teacher(int id, const string& name, const string& subject)
        : User(id, name), subject(subject) {}

    string getSubject() const { return subject; }
    void setSubject(const string& subject) { this->subject = subject; }

    void printInfo() const override {
        cout << "[Преподаватель] ID: " << id
             << " | Имя: " << name
             << " | Предмет: " << subject << endl;
    }
};

int main() {
    vector<User*> users;

    users.push_back(new Student(101, "Иван Иванов", "Группа А-101"));
    users.push_back(new Teacher(201, "Петр Петров", "Математика"));
    users.push_back(new Student(102, "Мария Сидорова", "Группа Б-202"));
    users.push_back(new Teacher(202, "Анна Смирнова", "Физика"));

    cout << "\nИнформация о пользователях" << endl;
    for (size_t i = 0; i < users.size(); ++i) {
        users[i]->printInfo();
    }

    cout << "\nУдаление объектов " << endl;
    for (size_t i = 0; i < users.size(); ++i) {
        delete users[i];
    }

    cout << "Все объекты удалены. Программа завершена." << endl;
    return 0;
}
