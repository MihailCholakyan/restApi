#include <string>
#include <iostream>
#include <vector>
using namespace std;

class Student; 

class User {
protected:
    int id;
    string name;

public:
    User(int id, const string& name) : id(id), name(name) {}
    virtual ~User() = default;

    int getId() const { return id; }
    string getName() const { return name; }

    virtual string getRole() const = 0;
    virtual void printInfo() const = 0;
};

class Teacher : public User {
private:
    string subject;
    vector<Student*> students; 

public:
    Teacher(int id, const string& name, const string& subject)
        : User(id, name), subject(subject) {}

   
    void addStudent(Student* s) {
        students.push_back(s);
    }

    
    const vector<Student*>& getStudents() const { 
        return students; 
    }

    string getRole() const override { return "Преподаватель"; }
    
    
    void printInfo() const override;
};

class Student : public User {
private:
    string group;
    Teacher* curator;

public:
    Student(int id, const string& name, const string& group, Teacher* curator)
        : User(id, name), group(group), curator(curator) {
        
        curator->addStudent(this); 
    }

    Teacher* getCurator() const { return curator; }

    string getRole() const override { return "Студент"; }

    void printInfo() const override {
        cout << "[Студент] ID: " << id << " | Имя: " << name
             << " | Группа: " << group 
             << " | Куратор: " << curator->getName() << endl;
    }
};


void Teacher::printInfo() const {
    cout << "[Преподаватель] ID: " << id << " | Имя: " << name
         << " | Предмет: " << subject 
         << " | Студентов: " << students.size() << endl;
}

void printAll(const vector<User*>& users) {
    cout << "\n=== Список пользователей ===" << endl;
    for (size_t i = 0; i < users.size(); ++i) {
        users[i]->printInfo();
    }
}

int main() {
    
    Teacher* t1 = new Teacher(201, "Петр Петров", "Математика");
    Teacher* t2 = new Teacher(202, "Анна Смирнова", "Физика");

    Student* s1 = new Student(101, "Иван Иванов", "Группа А-101", t1);
    Student* s2 = new Student(102, "Мария Сидорова", "Группа Б-202", t2);

    vector<User*> users;
    users.push_back(s1);
    users.push_back(s2);
    users.push_back(t1);
    users.push_back(t2);

    printAll(users);

    cout << "\n=== Связи 'куратор -> студенты' ===" << endl;
    for (size_t i = 0; i < users.size(); ++i) {
        // Ищем преподавателей
        Teacher* t = dynamic_cast<Teacher*>(users[i]);
        if (t != nullptr) {
            cout << "У куратора " << t->getName() << " студенты: ";
            for (size_t j = 0; j < t->getStudents().size(); ++j) {
                cout << t->getStudents()[j]->getName() << " ";
            }
            cout << endl;
        }
    }
    delete s1;
    delete s2;
    delete t1;
    delete t2;

    return 0;
}
